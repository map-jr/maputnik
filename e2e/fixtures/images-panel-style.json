{
  "id": "images-panel-style",
  "version": 8,
  "name": "Images panel",
  "metadata": {
    "maputnik:renderer": "mlgljs",
    "map-jr:images": {
      "pin": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 31\"><path fill=\"{{color}}\" stroke=\"{{stroke}}\" d=\"M12 30C12 30 2 17 2 11a10 10 0 0 1 20 0c0 6-10 19-10 19z\"/></svg>"
    }
  },
  "center": [0, 0],
  "zoom": 2,
  "sources": {
    "places": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          { "type": "Feature", "properties": {}, "geometry": { "type": "Point", "coordinates": [0, 0] } }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ffffff" }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "places",
      "layout": {
        "icon-image": "square",
        "icon-allow-overlap": true
      }
    }
  ]
}
